# Copie este arquivo para .env e preencha. O .env nunca é commitado.

NODE_ENV=development
PORT=3001

# Obrigatória. Conexão do Supabase, no cofre da equipe.
DATABASE_URL=postgresql://usuario:senha@host:6543/postgres

# Obrigatória. Uma sequência aleatória longa, inventada por você.
SESSION_SECRET=

SESSION_MAX_AGE_HOURS=8
CORS_ORIGIN=http://localhost:5173
BCRYPT_ROUNDS=12

# Fuso horário da loja/cliente. Decide o "hoje" dos cards do dashboard.
FUSO_HORARIO=America/Sao_Paulo

# Opcionais. Alertas de estoque por notificação push no celular. As três vão
# juntas; deixe todas vazias para rodar sem push. Gere o par de chaves com:
#   npx web-push generate-vapid-keys
# VAPID_SUBJECT é um contato da loja: mailto:alguem@dominio ou https://site
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
